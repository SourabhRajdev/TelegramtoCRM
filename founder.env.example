# ============================================================
# ARIA FOUNDER TERMINAL — Environment Variables
# ============================================================

PORT=3001
BASE_URL=https://your-railway-domain.up.railway.app

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_FOUNDER_CHAT_ID=your_personal_telegram_chat_id

# Gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Monday.com
MONDAY_API_TOKEN=your_monday_api_token
MONDAY_INQUIRIES_BOARD_ID=5027042315

# ============================================================
# HOW TO GET YOUR TELEGRAM CHAT ID:
# 1. Message your bot once
# 2. Open: https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
# 3. Find "chat":{"id": XXXXXXX} — that number is your chat ID
#
# HOW TO GET MONDAY API TOKEN:
# Monday.com → Profile pic → Admin → API → Copy token
# ============================================================
