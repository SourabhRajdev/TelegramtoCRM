# ============================================================
# ARIA FOUNDER TERMINAL — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# Server
PORT=3001
BASE_URL=https://your-railway-domain.up.railway.app

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_FOUNDER_CHAT_ID=your_personal_telegram_chat_id

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Monday.com CRM (V1 - Single Tenant)
MONDAY_API_TOKEN=your_monday_api_token
MONDAY_INQUIRIES_BOARD_ID=5027042315

# Monday.com OAuth (V2 - Multi Tenant)
# Create app at: https://monday.com/developers/apps
MONDAY_CLIENT_ID=your_monday_app_client_id
MONDAY_CLIENT_SECRET=your_monday_app_secret
MONDAY_REDIRECT_URI=https://your-railway-domain.up.railway.app/auth/monday/callback

# V2 Security & Database
# Generate key with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_64_character_hex_encryption_key
DATABASE_PATH=./data/aria.db

# Logging (optional)
LOG_LEVEL=info
